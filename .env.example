# ==============================================================================
# FetchIT — Environment Configuration Template
# SerpApi India Hackathon 2026 — Track 1: AI Agents
# Copy this file to .env.local and populate with your own credentials.
# NEVER commit .env.local or expose real secrets in source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Search Discovery Providers (Track 1 — SerpApi Integration)
# ------------------------------------------------------------------------------
# SERPAPI_API_KEY is the primary discovery engine for FetchIT.
# Get your API key at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY="your_serpapi_api_key_here"

# Discovery provider selection: "serpapi" (default when key is present) or "tavily"
DISCOVERY_PROVIDER="serpapi"

# Optional fallback search provider (Tavily):
TAVILY_API_KEY="your_tavily_api_key_here"

# ------------------------------------------------------------------------------
# 2. AI Understanding & Extraction Engine
# ------------------------------------------------------------------------------
# Google Gemini (Default active provider)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-flash-lite-latest"

# Optional alternative AI Providers:
# OPENAI_API_KEY="your_openai_api_key_here"
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"
# ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
# NEON_AI_GATEWAY_TOKEN="your_neon_ai_gateway_token_here"

# ------------------------------------------------------------------------------
# 3. Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Neon connection strings (pooled for queries, unpooled for migrations)
# Get from Neon Console: https://console.neon.tech
DATABASE_URL="postgresql://username:password@ep-bitter-morning-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-bitter-morning.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# ------------------------------------------------------------------------------
# 4. Authentication (Neon Auth & Twilio Verify)
# ------------------------------------------------------------------------------
# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL="https://your-project.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-project.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="generate_a_random_32_byte_base64_string_here"

# Twilio (Optional: for mobile OTP SMS verification)
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_VERIFY_SERVICE_SID="your_twilio_verify_service_sid_here"
